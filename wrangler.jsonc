{
  "name": "adityaupadhyay-dev",
  "compatibility_date": "2026-10-01",
  // Static site only: no Worker script. `npm run build` writes the site to dist/.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  },
  // Attaches the domain to this Worker and creates the DNS record
  // (the adityaupadhyay.dev zone must be in the same Cloudflare account).
  "routes": [
    { "pattern": "adityaupadhyay.dev", "custom_domain": true }
  ]
}
