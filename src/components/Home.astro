---
import fs from 'node:fs';
import path from 'node:path';
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Hero from './Hero.astro';
import Projects from './Projects.astro';
import Experience from './Experience.astro';
import Writing from './Writing.astro';
import Videos from './Videos.astro';
import Repos from './Repos.astro';
import Contact from './Contact.astro';
import { portfolio as D } from '../data/portfolio';

// Empty sections are left out of the page, and so are their nav links.
const tabLabels = { articles: 'Articles', blogs: 'Blogs', tutorials: 'Tutorials' } as const;
const writingTabs = Object.entries(tabLabels)
  .map(([key, label]) => ({ key, label, posts: D.writing[key as keyof typeof tabLabels] }))
  .filter((t) => t.posts.length);
const videos = D.videos.filter((v) => v.youtubeId);
const hasResume = fs.existsSync(path.join(process.cwd(), 'public', 'resume.pdf'));

const sections = [
  { id: 'work', label: 'Work', show: D.projects.length > 0 },
  { id: 'experience', label: 'Experience', show: D.experience.length > 0 },
  { id: 'writing', label: 'Writing', show: writingTabs.length > 0 },
  { id: 'videos', label: 'Videos', show: videos.length > 0 },
  { id: 'repos', label: 'Open source', show: D.repos.length > 0 },
];
const show = Object.fromEntries(sections.map((s) => [s.id, s.show]));
---
<Base
  title="Aditya Upadhyay | Forward Deployed Engineer"
  description="Aditya Upadhyay, Forward Deployed Engineer. Projects, experience, writing, tutorials and video walkthroughs."
  summary="I turn whiteboard promises into systems that actually run. Integrations, AI agents and tooling, shipped inside customer teams."
>
  <Header nav={sections.filter((s) => s.show)} />

  <main id="top" class="container">
    <Hero showDemo={show.videos} />
    {show.work && <Projects projects={D.projects} categories={D.categories} />}
    {show.experience && <Experience experience={D.experience} hasResume={hasResume} />}
    {show.writing && <Writing tabs={writingTabs} />}
    {show.videos && <Videos videos={videos} channel={D.links.youtube} />}
    {show.repos && <Repos repos={D.repos} github={D.links.github} />}
    <Contact links={D.links} />
  </main>

  <footer class="footer container">
    <span>&copy; {new Date().getFullYear()} Aditya Upadhyay</span>
    <span>Designed and built by hand. No templates were harmed.</span>
    <a href="#top">Back to top &uarr;</a>
  </footer>

  <script>
    import '../scripts/main';
  </script>
</Base>
